# Public site settings
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Bizfylr
NEXT_PUBLIC_WHATSAPP_NUMBER=15555550123
NEXT_PUBLIC_WHATSAPP_DISPLAY=+1 555 555 0123

# MySQL connection used by Prisma (required in production)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Razorpay live or test credentials (required for payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=replace-with-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-independent-webhook-secret

# SMTP (required for email outbox delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM_NAME=Bizfylr
SMTP_FROM_EMAIL=mailer@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com
SUPPORT_REPLY_TO_EMAIL=support@example.com

# Blog admin (required for /admin/blog)
BLOG_ADMIN_USERNAME=replace-with-admin-username
BLOG_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Hostinger cron endpoint authentication (required for email outbox worker)
CRON_SECRET=replace-with-at-least-32-random-characters

# Set these for the known Hostinger reverse-proxy chain
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# Optional analytics and verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
GOOGLE_SITE_VERIFICATION=
