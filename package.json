{
  "name": "bizfylr-next",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "node server.js",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run typecheck && npm test",
    "hostinger:build": "chmod -R u+x node_modules/@prisma/engines node_modules/.prisma 2>/dev/null || true; prisma generate && (chmod -R u+x node_modules/@prisma/engines node_modules/.prisma 2>/dev/null || true) && prisma migrate deploy && next build && (chmod -R u+x .next/standalone/node_modules/@prisma .next/standalone/node_modules/.prisma node_modules/@prisma/engines node_modules/.prisma 2>/dev/null || true)",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-character-count": "^3.23.4",
    "@tiptap/extension-code-block-lowlight": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/extension-youtube": "^3.23.4",
    "@tiptap/html": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.13.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "postcss": "8.5.14",
    "prisma": "^6.19.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
